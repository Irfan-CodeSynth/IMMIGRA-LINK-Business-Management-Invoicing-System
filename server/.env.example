# Server Production & Staging Environment Variables
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection URI (Replace with your actual MongoDB Atlas cluster credentials)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/immigra_link?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://admin:YourSecurePassword@cluster0.immigralink.mongodb.net/immigra_link?retryWrites=true&w=majority

# Secret key for JWT session token generation (Use 32+ random characters)
JWT_SECRET=replace_with_a_long_cryptographically_secure_random_string_2026
